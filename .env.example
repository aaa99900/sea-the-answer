# Copy to .env. Secrets are server-only and must never be committed.
HAEDAP_DB_PATH=data/haedap.sqlite
# Default port; --port / start.ps1 -Port takes precedence.
PORT=5173
# Optional: Python executable used only by PDF ingestion (install requirements-pdf.txt).
# HAEDAP_PYTHON=C:/path/to/python.exe
# Optional: set BOTH to enable the UI's explicit external-model option.
# OPENAI_API_KEY=
# OPENAI_MODEL=
